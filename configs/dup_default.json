{
 "corpus_path": "data/processed/corpus.jsonl",
 "gold_path": "data/processed/dup_candidates_from_text.jsonl",
 "name": "hybrid_structured",
 "seed": 13,
 "preprocess": {
  "lowercase": true,
  "keep_operators": true,
  "keep_numbers": true,
  "keep_negation": true,
  "bigrams": true,
  "mask_issue_refs": true,
  "max_token_len": 80
 },
 "extract": {
  "enabled": true,
  "use_tags": true,
  "use_sections": true,
  "use_signals": true,
  "use_facets": true,
  "max_entities": 40
 },
 "candidates": {
  "use_lexical": true,
  "use_semantic": true,
  "use_metadata": true,
  "lexical_k": 100,
  "semantic_k": 100,
  "metadata_k": 50,
  "pool_k": 150,
  "rrf_k": 60.0,
  "lexical_weight": 1.0,
  "semantic_weight": 1.0,
  "metadata_weight": 0.5,
  "metadata_min_idf": 2.0
 },
 "embedding": {
  "model": "intfloat/multilingual-e5-base",
  "device": "cpu",
  "batch_size": 32,
  "symmetric": true,
  "text_field": "text_dense",
  "cache_dir": "data/cache",
  "calibrate": true,
  "calibration_sample": 20000,
  "sem_lo": 0.0,
  "sem_hi": 1.0
 },
 "scoring": {
  "use_semantic": true,
  "use_lexical": true,
  "use_structured": true,
  "use_contradiction": true,
  "weights": {
   "semantic": 0.8,
   "lexical": 0.2,
   "function_match": 0.05,
   "module_match": 0.02,
   "domain_match": 0.02,
   "api_match": 0.05,
   "error_code_match": 0.08,
   "entity_overlap": 0.04,
   "field_overlap": 0.03,
   "action_overlap": 0.03,
   "provider_match": 0.02,
   "channel_match": 0.02,
   "expected_behavior_sim": 0.05,
   "observed_behavior_sim": 0.05,
   "operator_conflict": 0.3,
   "numeric_conflict": 0.22,
   "negation_conflict": 0.25,
   "status_conflict": 0.28,
   "action_conflict": 0.26,
   "identifier_conflict": 0.12,
   "entity_conflict": 0.16,
   "actor_conflict": 0.2,
   "channel_conflict": 0.15,
   "provider_conflict": 0.06,
   "error_code_conflict": 0.1
  },
  "hard_negative_gate": true,
  "hard_negative_min_sim": 0.7,
  "hard_negative_cap": 0.72
 },
 "rerank": {
  "enabled": false,
  "kind": "feature_weighted",
  "model": "BAAI/bge-reranker-base",
  "model_path": "data/models/reranker.joblib",
  "top_n": 30,
  "blend": 0.5,
  "device": "cpu",
  "batch_size": 16
 },
 "decision": {
  "t_duplicate": 0.78,
  "t_related": 0.55,
  "review_margin": 0.06,
  "top_k": 10,
  "max_explanation_signals": 4
 }
}
